<section class="platform-map panel" aria-labelledby="platform-map-title">
  <div class="map-copy">
    <p class="eyebrow">Architecture explorer · interactive system map</p><h2
      id="platform-map-title"
    >
      Explore my engineering environment
    </h2><p>
      A sanitized platform model based on recurring patterns in my daily engineering notes. Select a
      layer to see the concern it represents.
    </p>
  </div>
  <div class="diagram-wrap">
    <div class="diagram" role="group" aria-label="Interactive architecture diagram">
      <button data-node="cloud" class="node">Cloud<br /><strong>AWS</strong></button><i></i>
      <button data-node="iac" class="node">IaC<br /><strong>Atmos / Terraform</strong></button><i></i>
      <button data-node="cluster" class="node"
        >Orchestration<br /><strong>EKS / Kubernetes</strong></button
      ><i></i>
      <div class="node-row">
        <button data-node="identity" class="node">Identity</button><button
          data-node="delivery"
          class="node">Delivery</button
        ><button data-node="apps" class="node">Apps</button>
      </div><i></i>
      <button data-node="observe" class="node wide"
        >Observability <strong>Grafana · Loki · CloudWatch</strong></button
      >
    </div>
    <aside class="detail" aria-live="polite">
      <p class="eyebrow">Selected layer</p><h3 id="detail-title">Platform foundation</h3><p
        id="detail-text"
      >
        A composable cloud foundation built to make the right operational path the easy one.
      </p><p class="tags" id="detail-tags">AWS · Kubernetes · Terraform</p>
    </aside>
  </div>
</section>
<script>
  // @ts-nocheck
  const nodes = {
    cloud: [
      'Cloud foundation',
      'Cloud infrastructure creates a resilient foundation for applications and operations.',
      'AWS · Terraform · IAM',
    ],
    iac: [
      'Infrastructure as code',
      'Atmos and Terraform keep promotion environments understandable, reviewable, and repeatable.',
      'Terraform · Atmos · Policy as code',
    ],
    cluster: [
      'Kubernetes',
      'Container orchestration and the platform foundation for repeatable workload delivery.',
      'EKS · Helm · UDS · Zarf',
    ],
    identity: [
      'Identity boundary',
      'Keycloak groups and OIDC claims become the source of truth for application and dashboard access.',
      'Keycloak · OIDC · RBAC',
    ],
    delivery: [
      'Delivery workflow',
      'CI/CD and release ordering make platform changes move safely from dev through production.',
      'GitLab CI · CodePipeline · Workflows',
    ],
    apps: [
      'Mission apps',
      'Application onboarding needs infrastructure, package configuration, registry routing, auth, and dashboards to line up.',
      'PostgreSQL · IAM · Zarf config',
    ],
    observe: [
      'Observability',
      'Metrics, logs, dashboards, and alerts help engineers move from symptoms to evidence.',
      'Grafana · Loki · Prometheus · Vector · CloudWatch',
    ],
  };
  document.querySelectorAll('[data-node]').forEach((button) =>
    button.addEventListener('click', () => {
      const [title, text, tags] = nodes[button.dataset.node];
      document.querySelector('#detail-title').textContent = title;
      document.querySelector('#detail-text').textContent = text;
      document.querySelector('#detail-tags').textContent = tags;
      document.querySelectorAll('[data-node]').forEach((n) => n.removeAttribute('aria-current'));
      button.setAttribute('aria-current', 'true');
    }),
  );
</script>
