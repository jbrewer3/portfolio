<section class="incident panel" aria-labelledby="incident-title">
  <div>
    <h2 id="incident-title">Can you fix the outage?</h2><p>
      A fictional, sanitized incident scenario. Use the signals below to form a hypothesis.
    </p>
  </div>
  <div class="incident-grid">
    <div class="incident-status">
      <p class="alert">● Production incident</p><dl>
        <div><dt>API error rate</dt><dd>37%</dd></div><div>
          <dt>P95 latency</dt><dd>2.8s</dd>
        </div><div><dt>Healthy nodes</dt><dd>6 / 10</dd></div><div>
          <dt>Pending pods</dt><dd>42</dd>
        </div>
      </dl>
    </div><div>
      <div class="tabs" role="tablist" aria-label="Investigation signals">
        <button role="tab" aria-selected="true" data-tab="metrics">Metrics</button><button
          role="tab"
          data-tab="logs">Logs</button
        ><button role="tab" data-tab="events">Events</button><button role="tab" data-tab="cluster"
          >Cluster</button
        ><button role="tab" data-tab="architecture">Architecture</button>
      </div><pre
        id="incident-output"
        tabindex="0">
CPU utilization   ███████████████████  94%
Memory            ███████████████      76%
Pending pods      ████████████████████ 42</pre><button
        class="reveal"
        type="button">Reveal diagnosis</button
      ><div class="diagnosis" hidden>
        <h3>Root cause: capacity exhaustion</h3><p>
          Workloads cannot be scheduled because available node capacity is exhausted and additional
          capacity is not arriving quickly enough.
        </p><h4>Resolution approach</h4><p>
          Validate autoscaling signals and constraints, restore safe capacity, then confirm
          scheduling recovery. Prevent recurrence with capacity headroom, scaling tests, and
          alerting on pending workloads.
        </p><details>
          <summary>What I would check next</summary><p>
            Recent deploys, resource requests, autoscaler events, quota limits, node health, and the
            traffic pattern that drove demand.
          </p>
        </details>
      </div>
    </div>
  </div>
  <noscript>
    <p class="muted">
      JavaScript is disabled, so the tabs above are static. The diagnosis this simulator leads to:
    </p>
  </noscript>
  <details class="text-fallback">
    <summary>View all investigation signals and the diagnosis as text</summary>
    <dl>
      <dt>Metrics</dt>
      <dd>CPU utilization 94% · Memory 76% · Pending pods 42</dd>
      <dt>Logs</dt>
      <dd>service unavailable · pod pending · request waiting for available capacity</dd>
      <dt>Events</dt>
      <dd>FailedScheduling: Insufficient CPU · FailedScheduling: 0/6 nodes are available</dd>
      <dt>Cluster</dt>
      <dd>Nodes ready: 6 / 10 · Requested CPU: 94% · Pending workloads: 42</dd>
      <dt>Architecture</dt>
      <dd>
        Traffic → Ingress → Services → Worker capacity, with autoscaling feeding worker capacity.
      </dd>
      <dt>Diagnosis: capacity exhaustion</dt>
      <dd>
        Workloads cannot be scheduled because available node capacity is exhausted and additional
        capacity is not arriving quickly enough. Resolution approach: validate autoscaling signals
        and constraints, restore safe capacity, then confirm scheduling recovery. Prevention:
        capacity headroom, scaling tests, and alerting on pending workloads. What I would check
        next: recent deploys, resource requests, autoscaler events, quota limits, node health, and
        the traffic pattern that drove demand.
      </dd>
    </dl>
  </details>
</section>
<script>
  // @ts-nocheck
  const evidence = {
    metrics:
      'CPU utilization   ███████████████████  94%\nMemory            ███████████████      76%\nPending pods      ████████████████████ 42',
    logs: 'service unavailable\npod pending\nrequest waiting for available capacity',
    events: 'FailedScheduling: Insufficient CPU\nFailedScheduling: 0/6 nodes are available',
    cluster: 'Nodes ready: 6 / 10\nRequested CPU: 94%\nPending workloads: 42',
    architecture:
      'Traffic → Ingress → Services → Worker capacity\n                         ↘ Autoscaling',
  };
  document.querySelectorAll('[data-tab]').forEach((tab) =>
    tab.addEventListener('click', () => {
      document.querySelector('#incident-output').textContent = evidence[tab.dataset.tab];
      document
        .querySelectorAll('[data-tab]')
        .forEach((t) => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');
    }),
  );
  document.querySelector('.reveal')?.addEventListener('click', (event) => {
    document.querySelector('.diagnosis').hidden = false;
    event.currentTarget.hidden = true;
  });
</script>
