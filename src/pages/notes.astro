---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Notes"
  ><section class="page-hero shell">
    <h1>Notes from the<br />engineering desk.</h1><p class="lede">
      A lightweight, Markdown-ready publishing space for ideas that are still being tested, learned,
      and made useful. Every entry here is a draft or planned outline&mdash;none represent finished
      writing.
    </p>
  </section><section class="shell note-list">
    {
      notes.map((note) => (
        <article>
          <div>
            <p class="eyebrow">
              {note.data.category} · {note.data.status === 'draft' ? 'Draft' : 'Planned'}
            </p>
            <h2>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </h2>
            <p class="muted">{note.data.description}</p>
          </div>
          <span class="status">{note.data.status === 'draft' ? 'Draft' : 'Planned'}</span>
        </article>
      ))
    }
  </section></BaseLayout
>
