---
import BaseLayout from '../layouts/BaseLayout.astro';
const drafts = [
  ['Grafana RBAC without Grafana Enterprise', 'Observability · Keycloak · Draft'],
  ['Terraform as the boundary between platform apps and platform content', 'IaC · Architecture note'],
  ['What database restore tests taught me about end-to-end operational time', 'PostgreSQL · Runbook'],
  ['CloudWatch-backed Grafana dashboards that survive environment promotion', 'Grafana · CloudWatch'],
  ['Mission app onboarding checklists: auth, registry, infra, dashboards', 'Platform ops · Template'],
  ['UDS package variable renames as an auth troubleshooting class', 'Zarf · Keycloak · Lesson'],
  ['Building Heads-up with atomic state machines and an outbox', 'Product engineering · Draft'],
  ['Applying MIS analytics to platform operations', 'Texas A&M MS MIS · Planned'],
];
---

<BaseLayout title="Notes"
  ><section class="page-hero shell">
    <p class="eyebrow">Notes</p><h1>Notes from the<br />engineering desk.</h1><p class="lede">
      A publishing backlog shaped by daily notes: architecture decisions, incident lessons,
      runbooks, product design notes, and the platform patterns that keep showing up.
    </p>
  </section><section class="shell note-list">
    {
      drafts.map(([title, meta]) => (
        <article>
          <>
            <div>
              <>
                <p class="eyebrow">{meta}</p>
                <h2>{title}</h2>
              </>
            </div>
            <span class="status">Draft / planned</span>
          </>
        </article>
      ))
    }
  </section></BaseLayout
>
