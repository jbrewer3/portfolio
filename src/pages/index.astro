---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformMap from '../components/PlatformMap.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import { site } from '../data/site';

const proofPoints = [
  ['7+ yrs', 'Systems, cloud & platform engineering'],
  ['182+', 'Production-down AWS cases resolved'],
  ['Production EKS', 'Operated at Defense Unicorns'],
  ['M.S. MIS', 'Texas A&M, in progress'],
];
---

<BaseLayout title="Platform Engineering · Cloud Infrastructure · Data">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Platform engineering · cloud infrastructure · data</p><h1>
        Joshua<br /><em>Brewer</em>
      </h1><p class="hero-statement">I build systems that engineers can depend on.</p><p
        class="lede"
      >
        Platform Engineer focused on cloud infrastructure, automation, observability, security, and
        data-driven systems. Currently expanding that foundation through an M.S. in Management
        Information Systems at Texas A&amp;M University.
      </p><div class="actions">
        <a class="button" href="/projects/">Explore my work</a><a
          class="button secondary"
          href="/resume/">View resume</a
        ><a class="text-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div><div class="progression" aria-label="Engineering career progression">
        <span>Systems</span><b>→</b><span>Cloud</span><b>→</b><span>Platform</span><b>→</b><span
          >Data</span
        >
      </div>
    </div>
  </section>
  <section class="shell proof-strip" aria-label="Career highlights">
    {
      proofPoints.map(([figure, label]) => (
        <div class="proof-item">
          <span class="proof-figure">{figure}</span>
          <span class="proof-label">{label}</span>
        </div>
      ))
    }
  </section>
  <div class="shell stack">
    <CareerTimeline />
    <PlatformMap />
    <section class="close-cta">
      <h2>
        Interested in what platform reliability and data-driven engineering could look like on your
        team?
      </h2><div class="actions">
        <a class="button" href="/resume/">View resume</a><a
          class="button secondary"
          href="/projects/">See projects</a
        ><a class="text-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </section>
  </div>
</BaseLayout>
