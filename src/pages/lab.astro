---
import BaseLayout from '../layouts/BaseLayout.astro';
const labs = [
  ['Cloud', 'AWS · infrastructure architecture · cost awareness'],
  ['Kubernetes', 'EKS · cluster lifecycle · autoscaling · GitOps'],
  ['Infrastructure as Code', 'Terraform · reusable modules · CI/CD'],
  ['Observability', 'Prometheus · Grafana · Loki · logging · alerting'],
  ['Automation', 'Go · Python · PowerShell'],
  ['Security', 'IAM · identity · infrastructure security · compliance automation'],
  ['Data', 'Python · SQL · pipelines · warehousing · analytics'],
];
---

<BaseLayout title="Engineering Lab"
  ><section class="page-hero shell">
    <p class="eyebrow">Engineering Lab</p><h1>A working catalog<br />of systems thinking.</h1><p
      class="lede"
    >
      A growing collection of technical explorations, patterns, and lessons. Entries will link to
      public code where available and clearly identify their status.
    </p>
  </section><section class="shell lab-grid">
    {
      labs.map(([name, description]) => (
        <article class="lab-card">
          <>
            <p class="eyebrow">{name}</p>
            <h2>{name}</h2>
            <p>{description}</p>
            <span class="status">Coming soon</span>
          </>
        </article>
      ))
    }
  </section></BaseLayout
>
